---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AntesDespues from '../components/AntesDespues.astro';
import Recorrido from '../components/Recorrido.astro';
import ComoArrancas from '../components/ComoArrancas.astro';
import Funciones from '../components/Funciones.astro';
import DespachoAutomatico from '../components/DespachoAutomatico.astro';
import ModulosInteligentes from '../components/ModulosInteligentes.astro';
import Seguridad from '../components/Seguridad.astro';
import ConQueContas from '../components/ConQueContas.astro';
import DemoPersonalizada from '../components/DemoPersonalizada.astro';
import Testimonios from '../components/Testimonios.astro';
import Planes from '../components/Planes.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import BotonVolverArriba from '../components/BotonVolverArriba.astro';
import BotonFlotanteDemo from '../components/BotonFlotanteDemo.astro';
import PaletaComandos from '../components/PaletaComandos.astro';

const title = 'SPLG — Pedidos, reparto y envases para distribuidoras de gas';
const description =
  'SPLG, un producto de OrixTech (Nahuel Wagner): app del cliente, app del chofer y panel para distribuidoras de garrafas, con despacho automático al chofer más cercano, seguimiento en vivo, cobros y trazabilidad de envases.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <AntesDespues />
  <Recorrido />
  <ComoArrancas />
  <Funciones />
  <DespachoAutomatico />
  <ModulosInteligentes />
  <Seguridad />
  <ConQueContas />
  <DemoPersonalizada />
  <Testimonios />
  <Planes />
  <Faq />
  <Contacto />
  <BotonVolverArriba />
  <BotonFlotanteDemo />
  <PaletaComandos />
</BaseLayout>
