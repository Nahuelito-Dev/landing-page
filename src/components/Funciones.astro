---
import { bloquesFunciones } from '../data/funciones';
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import MockCliente from './MockCliente.astro';
import MockChofer from './MockChofer.astro';
import MockEnvases from './MockEnvases.astro';
import Items from './FuncionesItems.astro';
import BotonesTiendas from './BotonesTiendas.astro';
import type { BloqueFunciones } from '../data/funciones';

/** Con muchas funciones, la lista va a lo ancho debajo de la maqueta. */
const ancho = (bloque: BloqueFunciones) => bloque.items.length > 6;

---

<section id="producto" class="bg-bg py-20 sm:py-24 lg:py-28" aria-labelledby="titulo-producto">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-revelar>
    <EncabezadoSeccion
      id="titulo-producto"
      rotulo="El producto"
      titulo="Tres piezas que trabajan juntas"
      bajada="La app del cliente, la app del chofer y el panel de la distribuidora comparten los mismos pedidos, en tiempo real."
    />
    </div>

    <div class="mt-16 flex flex-col gap-20 lg:gap-28">
      {
        bloquesFunciones.map((bloque, indice) => (
          <article
            data-revelar
            id={bloque.id}
            class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12"
            aria-labelledby={`titulo-${bloque.id}`}
          >
            <div class={`min-w-0 lg:col-span-5 ${indice % 2 === 1 ? 'lg:order-2 lg:col-start-8' : ''}`}>
              <p class="font-mono text-xs font-semibold text-primary-strong">0{indice + 1}</p>
              <h3 id={`titulo-${bloque.id}`} class="mt-2 font-heading text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                {bloque.titulo}
              </h3>
              <p class="mt-3 text-pretty text-base leading-relaxed text-muted">{bloque.bajada}</p>

              {!ancho(bloque) && <Items items={bloque.items} />}
              {bloque.id === 'cliente' && <BotonesTiendas class="mt-8" />}
            </div>

            <div
              class={`relative flex min-w-0 justify-center overflow-hidden rounded-3xl border border-outline bg-surface px-5 py-10 sm:px-10 lg:col-span-7 ${
                indice % 2 === 1 ? 'lg:order-1 lg:col-start-1' : ''
              }`}
            >
              <div class="reticula pointer-events-none absolute inset-0" aria-hidden="true" />
              <div
                class="pointer-events-none absolute -bottom-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-primary-soft blur-3xl"
                aria-hidden="true"
              />
              <div class="relative w-full">
                {bloque.id === 'cliente' && <MockCliente class="mx-auto" />}
                {bloque.id === 'chofer' && <MockChofer class="mx-auto" />}
                {bloque.id === 'panel' && <MockEnvases />}
              </div>
            </div>

            {ancho(bloque) && (
              <div class="lg:col-span-12">
                <Items items={bloque.items} columnas />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
