---
type Props = {
  class?: string;
  /** Texto blanco, para fondos oscuros */
  invertido?: boolean;
};

const { class: className = '', invertido = false } = Astro.props;
---

<a
  href="/"
  class={`flex items-center gap-2.5 font-heading text-lg font-bold tracking-tight ${invertido ? 'text-white' : 'text-ink'} ${className}`}
  aria-label="SPLG, ir al inicio"
>
  <span class="btn-primary flex h-8 w-8 shrink-0 items-center justify-center rounded-lg" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor">
      <path
        d="M12 1.6c2.7 3 3.6 5.7 1.9 8.4 1.6-.4 2.8-1.5 3.4-3.1 1.7 2.3 2.2 5 .9 7.7-1.3 2.9-4.2 4.4-7.2 4.4-3.3 0-6.4-1.9-7-5.3-.5-2.8.9-5 2.8-6.6-.2 1.3.2 2.4 1.1 3.1-.9-3.2.5-6.4 4.1-8.6Z"
      ></path>
    </svg>
  </span>
  <span>SPLG</span>
</a>
