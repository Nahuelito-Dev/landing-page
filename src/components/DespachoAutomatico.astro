---
import EncabezadoSeccion from './EncabezadoSeccion.astro';

const radios = [
  { r: 44, km: '5 km', opacidad: 0.9 },
  { r: 80, km: '10 km', opacidad: 0.65 },
  { r: 116, km: '15 km', opacidad: 0.45 },
  { r: 150, km: '20 km', opacidad: 0.3 },
];

const reglas = [
  { titulo: 'Primero, el más cercano', texto: 'El pedido se ofrece al chofer libre más cerca dentro de 5 km.' },
  { titulo: 'Tiempo corto para aceptar', texto: 'Si no responde a tiempo, pasa al siguiente sin que nadie intervenga.' },
  { titulo: 'El radio crece solo', texto: 'Sin choferes cerca, la búsqueda se amplía a 10, 15 y 20 km.' },
];
---

<section class="side-glow py-20 text-white sm:py-24 lg:py-28" aria-labelledby="titulo-despacho">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div class="min-w-0" data-revelar>
      <EncabezadoSeccion
        id="titulo-despacho"
        invertido
        rotulo="Despacho automático"
        titulo="Nadie tiene que salir a buscar chofer"
        bajada="Cuando entra un pedido, el sistema lo ofrece al chofer libre más cercano. Es el primero de los módulos inteligentes."
      />

      <ol class="mt-10 flex flex-col">
        {
          reglas.map(({ titulo, texto }, i) => (
            <li class="flex gap-4 border-t border-side-line py-5">
              <span class="font-mono text-sm font-semibold text-side-text">0{i + 1}</span>
              <span>
                <span class="block font-semibold text-white">{titulo}</span>
                <span class="mt-1 block text-sm leading-relaxed text-side-text">{texto}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mx-auto w-full max-w-md" data-revelar>
      <div aria-hidden="true">
      <svg viewBox="0 0 340 340" class="h-auto w-full">
        {
          radios
            .slice()
            .reverse()
            .map(({ r, opacidad }) => (
              <circle
                cx="170"
                cy="170"
                r={r}
                fill="var(--color-side-accent)"
                fill-opacity={0.04}
                stroke="var(--color-side-accent)"
                stroke-opacity={opacidad}
                stroke-width="1.2"
                stroke-dasharray="3 5"
              />
            ))
        }
        {
          radios.map(({ r, km }) => (
            <text
              x={170}
              y={170 - r - 6}
              fill="var(--color-side-text)"
              font-size="11"
              text-anchor="middle"
              style="font-family: var(--font-mono)"
            >
              {km}
            </text>
          ))
        }
        <path d="M170 170 L 214 136" stroke="var(--color-side-accent)" stroke-width="1.5" stroke-dasharray="2 3"></path>
        <circle cx="170" cy="170" r="14" fill="var(--color-primary)" opacity="0.35"></circle>
        <circle cx="170" cy="170" r="7" fill="var(--color-side-accent)"></circle>
        <circle cx="214" cy="136" r="6" fill="white"></circle>
        <circle cx="214" cy="136" r="10" fill="none" stroke="white" stroke-opacity="0.35"></circle>
        <circle cx="112" cy="214" r="5" fill="var(--color-side-text)"></circle>
        <circle cx="250" cy="236" r="5" fill="var(--color-side-text)" opacity="0.7"></circle>
        <circle cx="90" cy="98" r="5" fill="var(--color-side-text)" opacity="0.5"></circle>
      </svg>
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-side-text">
        <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-side-accent"></span>Pedido</span>
        <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-white"></span>Chofer que recibe la oferta</span>
        <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-side-text"></span>Otros choferes</span>
      </div>
    </div>
  </div>
</section>
