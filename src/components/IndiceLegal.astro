---
/** Índice con anclas al principio de las páginas legales. */
type Props = { items: { id: string; texto: string }[] };
const { items } = Astro.props;
---

<nav aria-label="Índice de esta página" class="rounded-xl border border-outline bg-surface p-5">
  <p class="!mt-0 text-sm font-semibold text-ink">En esta página</p>
  <ol class="!mt-3 !list-none !pl-0 columns-1 gap-8 sm:columns-2">
    {items.map((i) => <li class="!pl-0 break-inside-avoid"><a href={`#${i.id}`}>{i.texto}</a></li>)}
  </ol>
</nav>
