---
/**
 * «Con qué contás»: compromisos y respaldo del sistema SPLG (patrón Commitments.tsx).
 * Datos en src/data/compromisos.ts.
 */
import { GraduationCap, Lock, MessageCircle, ShieldCheck, Sparkles, UploadCloud } from 'lucide-react';
import type { LucideIcon } from 'lucide-react';
import { compromisos } from '../data/compromisos';
import EncabezadoSeccion from './EncabezadoSeccion.astro';

const iconos: Record<string, LucideIcon> = {
  MessageCircle,
  GraduationCap,
  UploadCloud,
  ShieldCheck,
  Sparkles,
  Lock,
};
---

<section id="con-que-contas" class="border-t border-outline bg-surface py-20 sm:py-24 lg:py-28" aria-labelledby="titulo-compromisos">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-revelar>
      <EncabezadoSeccion
        id="titulo-compromisos"
        rotulo="Con qué contás"
        titulo="Respaldo y acompañamiento desde el primer día"
        bajada="Todo lo necesario para que tu distribuidora trabaje con tranquilidad, sin sorpresas ni costos ocultos."
      />
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        compromisos.map((c) => {
          const Icono = iconos[c.icono] ?? Sparkles;
          return (
            <li class="tarjeta flex items-start gap-4 rounded-2xl border border-outline bg-bg p-5" data-revelar>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary-strong">
                <Icono size={20} strokeWidth={1.9} aria-hidden="true" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-heading text-base font-semibold leading-snug text-ink">{c.titulo}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{c.descripcion}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
