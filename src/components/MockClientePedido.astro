---
/** Maqueta de la app del cliente: armar y confirmar un pedido. Ilustrativa. */
import { Banknote, CalendarClock, Flame, MapPin, Minus, Plus } from 'lucide-react';
import Telefono from './Telefono.astro';

type Props = { class?: string };
const { class: className = '' } = Astro.props;
---

<Telefono class={className}>
  <div class="px-4 pb-4 pt-9">
    <p class="text-[10px] font-medium text-muted">Nuevo pedido</p>
    <p class="mt-0.5 text-lg font-semibold tracking-tight text-ink">¿Qué necesitás?</p>

    <div class="mt-3 flex items-center gap-3 rounded-xl border border-primary bg-primary-soft p-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface text-primary-strong">
        <Flame size={16} strokeWidth={1.8} />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block whitespace-nowrap text-[11px] font-semibold text-ink">Garrafa 10 kg</span>
        <span class="block whitespace-nowrap text-[10px] text-muted">Canje de envase</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="flex h-6 w-6 items-center justify-center rounded-full border border-outline-strong bg-surface text-ink-2"><Minus size={11} /></span>
        <span class="w-3 text-center font-mono text-xs font-semibold text-ink">2</span>
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-on-primary"><Plus size={11} /></span>
      </span>
    </div>

    <div class="mt-2 flex items-center gap-3 rounded-xl border border-outline p-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-muted text-muted">
        <Flame size={16} strokeWidth={1.8} />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-[11px] font-semibold text-ink">Garrafa 15 kg</span>
        <span class="block whitespace-nowrap text-[10px] text-muted">Canje de envase</span>
      </span>
      <span class="flex h-6 w-6 items-center justify-center rounded-full border border-outline-strong text-ink-2"><Plus size={11} /></span>
    </div>

    <ul class="mt-3 flex flex-col divide-y divide-outline-soft rounded-xl border border-outline text-[11px]">
      <li class="flex items-center gap-2 px-2.5 py-2">
        <MapPin size={13} className="shrink-0 text-primary-strong" />
        <span class="flex-1 text-ink">Mi casa · Barrio Centro</span>
      </li>
      <li class="flex items-center gap-2 px-2.5 py-2">
        <CalendarClock size={13} className="shrink-0 text-primary-strong" />
        <span class="flex-1 text-ink">Entrega en el día</span>
      </li>
      <li class="flex items-center gap-2 px-2.5 py-2">
        <Banknote size={13} className="shrink-0 text-primary-strong" />
        <span class="flex-1 text-ink">Efectivo al recibir</span>
      </li>
    </ul>

    <span class="btn-primary mt-4 flex items-center justify-center rounded-xl py-2.5 text-[11px] font-semibold">
      Confirmar pedido
    </span>
  </div>
</Telefono>
