---
/**
 * Maqueta del panel de la distribuidora (tablero con pedidos en vivo), hecha con los mismos roles
 * que el panel: cambia de color con el selector. Ilustrativa: no lleva datos de personas reales.
 */
type Props = {
  /** El primer pedido aparece recién entregado y resaltado (paso final del recorrido). */
  entregaReciente?: boolean;
};
const { entregaReciente = false } = Astro.props;

import { Bell, Boxes, ChevronRight, LayoutDashboard, Map, MapPinned, Plus, ReceiptText, Truck } from 'lucide-react';

const menu = [
  { icono: LayoutDashboard, texto: 'Tablero', activo: true },
  { icono: ReceiptText, texto: 'Pedidos', contador: '4' },
  { icono: MapPinned, texto: 'Seguimiento en vivo' },
  { icono: Truck, texto: 'Choferes' },
  { icono: Boxes, texto: 'Envases' },
  { icono: Map, texto: 'Zonas de cobertura' },
];

const estados = {
  pendiente: { texto: 'Sin chofer', clase: 'bg-warn-soft text-warn', punto: 'bg-warn' },
  aceptado: { texto: 'Aceptado', clase: 'bg-info-soft text-info', punto: 'bg-info' },
  camino: { texto: 'En camino', clase: 'bg-primary-soft text-primary-strong', punto: 'bg-primary' },
  entregado: { texto: 'Entregado', clase: 'bg-success-soft text-success', punto: 'bg-success' },
} as const;

const pedidos: Array<{ id: string; detalle: string; zona: string; estado: keyof typeof estados }> = [
  { id: '#3A91F2', detalle: '2 × Garrafa 10 kg', zona: 'Centro', estado: entregaReciente ? 'entregado' : 'camino' },
  { id: '#3A91E8', detalle: '1 × Garrafa 15 kg', zona: 'Villa Sarita', estado: 'aceptado' },
  { id: '#3A91D4', detalle: '3 × Garrafa 10 kg', zona: 'Itaembé Miní', estado: 'pendiente' },
  { id: '#3A91C0', detalle: '1 × Garrafa 45 kg', zona: 'Centro', estado: 'entregado' },
];

const indicadores = [
  { texto: 'En curso', valor: '12' },
  { texto: 'Sin chofer', valor: '1' },
  { texto: 'Entregados hoy', valor: entregaReciente ? '39' : '38' },
];
---

<div
  class="maqueta overflow-hidden rounded-xl border border-outline-strong/80 bg-surface shadow-[0_24px_60px_-20px_rgb(16_24_40/0.35),0_2px_6px_rgb(16_24_40/0.06)]"
  aria-hidden="true"
>
  <div class="flex items-center gap-1.5 border-b border-outline bg-surface-sunken px-3 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-outline-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-outline-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-outline-strong"></span>
    <span class="ml-3 hidden rounded-md border border-outline bg-surface px-2.5 py-0.5 font-mono text-[10px] text-muted sm:inline">
      Panel de la distribuidora
    </span>
  </div>

  <div class="flex">
    <!-- Menú lateral: el oscuro de la marca, como en el panel -->
    <div class="side-glow hidden w-44 shrink-0 flex-col gap-0.5 px-2.5 py-3 sm:flex">
      <div class="mb-3 flex items-center gap-2 px-1.5">
        <span class="btn-primary flex h-6 w-6 items-center justify-center rounded-md">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
            <path
              d="M12 1.6c2.7 3 3.6 5.7 1.9 8.4 1.6-.4 2.8-1.5 3.4-3.1 1.7 2.3 2.2 5 .9 7.7-1.3 2.9-4.2 4.4-7.2 4.4-3.3 0-6.4-1.9-7-5.3-.5-2.8.9-5 2.8-6.6-.2 1.3.2 2.4 1.1 3.1-.9-3.2.5-6.4 4.1-8.6Z"
            ></path>
          </svg>
        </span>
        <span class="text-xs font-semibold text-white">Tu distribuidora</span>
      </div>
      {
        menu.map(({ icono: Icono, texto, activo, contador }) => (
          <span
            class={`flex items-center gap-2 rounded-md px-2 py-1.5 text-[11px] font-medium ${
              activo ? 'bg-[color-mix(in_srgb,var(--color-primary)_16%,var(--color-side))] text-white' : 'text-side-text'
            }`}
          >
            <Icono size={13} strokeWidth={1.8} className={activo ? 'text-side-accent' : ''} />
            <span class="flex-1 truncate">{texto}</span>
            {contador && (
              <span class="rounded bg-side-raised px-1.5 font-mono text-[10px] text-side-text">{contador}</span>
            )}
          </span>
        ))
      }
    </div>

    <!-- Contenido -->
    <div class="min-w-0 flex-1 bg-bg p-3 sm:p-4">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <p class="flex items-center gap-1 text-[10px] text-muted">
            Operación <ChevronRight size={10} /> Tablero
          </p>
          <p class="truncate text-sm font-semibold tracking-tight text-ink">Pedidos en vivo</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <span class="hidden h-7 w-7 items-center justify-center rounded-md border border-outline bg-surface text-muted sm:flex">
            <Bell size={13} />
          </span>
          <span class="btn-primary inline-flex items-center gap-1 rounded-md px-2.5 py-1.5 text-[11px] font-semibold">
            <Plus size={12} strokeWidth={2.4} /> Nuevo pedido
          </span>
        </div>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2">
        {
          indicadores.map(({ texto, valor }) => (
            <div class="rounded-lg border border-outline bg-surface px-2.5 py-2">
              <p class="truncate text-[10px] text-muted">{texto}</p>
              <p class="mt-0.5 font-mono text-base font-semibold text-ink">{valor}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-3 overflow-hidden rounded-lg border border-outline bg-surface">
        <div class="flex items-center justify-between border-b border-outline px-3 py-2">
          <span class="text-[11px] font-semibold text-ink">Pedidos de hoy</span>
          <span class="hidden text-[10px] text-muted sm:inline">Se asignan solos al chofer más cercano</span>
        </div>
        <ul class="divide-y divide-outline-soft">
          {
            pedidos.map(({ id, detalle, zona, estado }) => (
              <li class={`flex items-center gap-3 px-3 py-2 ${entregaReciente && id === '#3A91F2' ? 'bg-primary-soft' : ''}`}>
                <span class="hidden w-16 shrink-0 font-mono text-[10px] text-ink-2 sm:block">{id}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[11px] font-medium text-ink">{detalle}</span>
                  <span class="block truncate text-[10px] text-muted">{zona}</span>
                </span>
                <span
                  class={`inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold ${estados[estado].clase}`}
                >
                  <span class={`h-1.5 w-1.5 rounded-full ${estados[estado].punto}`} />
                  {estados[estado].texto}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>
