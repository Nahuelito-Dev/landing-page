---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Asistente from '../components/Asistente.astro';
import { CLAVE_MODO, CLAVE_TEMA, TEMA_POR_OMISION, temas } from '../data/temas';

type Props = {
  title: string;
  description: string;
  /** Páginas que no van al buscador (p. ej. «¡Gracias!») */
  noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlOg = new URL('/og.png', Astro.site);
const idsTemas = temas.map((tema) => tema.id);
---

<!doctype html>
<html lang="es-AR" data-tema={TEMA_POR_OMISION}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Antes de pintar: el color y el modo guardados (o el modo del sistema), la marca de que hay JS y,
      si no se pidió menos movimiento, la de las apariciones al hacer scroll. Sin JS no se oculta nada.
    -->
    <script is:inline define:vars={{ claveTema: CLAVE_TEMA, claveModo: CLAVE_MODO, ids: idsTemas }}>
      const raiz = document.documentElement;
      raiz.classList.add('js');
      let modo = null;
      try {
        const tema = localStorage.getItem(claveTema);
        if (tema && ids.includes(tema)) raiz.dataset.tema = tema;
        modo = localStorage.getItem(claveModo);
      } catch {
        /* sin localStorage: color por omisión y modo del sistema */
      }
      const oscuro = modo ? modo === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches;
      raiz.classList.toggle('dark', oscuro);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        raiz.classList.add('revelar');
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={urlCanonica} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SPLG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={urlOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SPLG, de OrixTech (Nahuel Wagner): pedidos, reparto y envases de tu distribuidora de gas" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlOg} />

    <Font cssVariable="--font-geist" preload={[{ weight: '400' }, { weight: '600' }]} />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body class="bg-bg text-ink">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido" class="pt-16">
      <slot />
    </main>

    <Footer />
    <Asistente />

    <script>
      // Apariciones al hacer scroll: sólo si el <head> dejó la clase `revelar` (hay JS y movimiento).
      if (document.documentElement.classList.contains('revelar')) {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('visible');
                observador.unobserve(entrada.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('[data-revelar]').forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>
