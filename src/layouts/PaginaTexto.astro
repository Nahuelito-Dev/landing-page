---
/** Páginas de texto (seguridad, legales): encabezado, índice opcional y cuerpo con estilos de lectura. */
import BaseLayout from './BaseLayout.astro';

type Props = {
  title: string;
  description: string;
  rotulo: string;
  titulo: string;
  bajada?: string;
  actualizado?: string;
  noindex?: boolean;
};

const { title, description, rotulo, titulo, bajada, actualizado, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="bg-bg">
    <header class="border-b border-outline bg-surface">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <p class="eyebrow inline-flex items-center gap-2">
          <span class="h-px w-5 bg-primary" aria-hidden="true"></span>
          {rotulo}
        </p>
        <h1 class="mt-3 text-balance font-heading text-3xl font-semibold leading-[1.1] text-ink sm:text-[2.75rem]">{titulo}</h1>
        {bajada && <p class="mt-4 text-pretty text-base leading-relaxed text-muted sm:text-lg">{bajada}</p>}
        {actualizado && <p class="mt-6 text-sm text-muted">Última actualización: {actualizado}</p>}
      </div>
    </header>
    <div class="texto-legal mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .texto-legal :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .texto-legal :global(h2:first-child) {
    margin-top: 0;
  }
  .texto-legal :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .texto-legal :global(p),
  .texto-legal :global(li) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-2);
  }
  .texto-legal :global(p) {
    margin-top: 1rem;
  }
  .texto-legal :global(ul),
  .texto-legal :global(ol) {
    margin-top: 1rem;
    padding-left: 1.25rem;
  }
  .texto-legal :global(ul) {
    list-style: disc;
  }
  .texto-legal :global(ol) {
    list-style: decimal;
  }
  .texto-legal :global(li + li) {
    margin-top: 0.5rem;
  }
  .texto-legal :global(a) {
    font-weight: 500;
    color: var(--color-primary-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .texto-legal :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
